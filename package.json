{
  "name": "seyvo",
  "version": "0.1.6",
  "description": "Windows voice dictation with your own Gemini API key",
  "main": "out/main/index.js",
  "author": "Tirthankar Dasgupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tirthankardgen-cell/Seyvo.git"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "npm run build:native && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build": "npm run build:native && electron-vite build",
    "dist:win": "npm run build && node node_modules/electron/install.js && node scripts/package.mjs",
    "test:native": "npm run build:native && node scripts/test-native.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:files": "node scripts/test-file-dialogs.mjs",
    "benchmark:win": "node scripts/benchmark.mjs",
    "supply-chain": "node scripts/supply-chain.mjs",
    "checksums": "node scripts/checksums.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
